server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Backend containers can be recreated independently. Resolve their Docker
  # service name at request time instead of retaining an obsolete IP address.
  resolver 127.0.0.11 ipv6=off valid=10s;
  set $api_upstream ${API_UPSTREAM};

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The entry document must be revalidated when Telegram opens a new WebView,
  # otherwise an old index can keep pointing at a previous frontend build.
  location = /index.html {
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    try_files $uri =404;
  }

  # Vite names build assets with a content hash, so they are safe to cache.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
