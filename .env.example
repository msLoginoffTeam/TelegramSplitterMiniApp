# Browser code always calls same-origin /api. Vite/Nginx proxy chooses the backend.
VITE_API_BASE_URL=/api
# Для локальной разработки из Rider: http://localhost:5028 (ASPNETCORE_ENVIRONMENT=Development).
# Docker API на 5050 работает в Production и dev identity намеренно не принимает.
VITE_DEV_API_PROXY_TARGET=http://localhost:5028

# Точный hostname текущего Cloudflare Quick Tunnel для теста Mini App.
# При каждом новом tunnel URL обычно меняется; значение не содержит секретов.
# VITE_DEV_ALLOWED_HOST=your-subdomain.trycloudflare.com

# Только для browser-mode локальной разработки с ASPNETCORE_ENVIRONMENT=Development.
# Это не Telegram initData и не должно попадать в production env.
# VITE_DEV_TELEGRAM_USER_ID=123456789

# Docker Nginx upstream. OrbStack/Docker Desktop can use this default locally.
# On a server set an explicit HTTPS API origin, for example https://api.example.com.
API_UPSTREAM=http://host.docker.internal:5050
WEB_PORT=5173
