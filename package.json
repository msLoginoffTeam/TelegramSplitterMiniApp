{
  "name": "telegram-splitter-mini-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "yarn": ">=4.18.0 <5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --from-snapshot && git diff --exit-code -- openapi/backend.json src/shared/api/generated"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@tma.js/sdk-react": "3.0.23",
    "axios": "1.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "react-query-swagger": "15.13.2",
    "react-router-dom": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "oxlint": "1.76.0",
    "prettier": "3.6.2",
    "sass": "1.92.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
